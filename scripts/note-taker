#!/usr/bin/env bash
# Start the note-taker server (if not already running) and open the viewer window.
#   note-taker            server + viewer window
#   note-taker --server   server only (foreground)
#   note-taker --no-open  same as --server
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PORT="${NOTE_TAKER_PORT:-$(sed -n 's/.*"port": *\([0-9]*\).*/\1/p' "${XDG_CONFIG_HOME:-$HOME/.config}/note-taker/config.json" 2>/dev/null || true)}"
PORT="${PORT:-7777}"
BASE="http://localhost:$PORT"
OPEN=1
SERVER_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --server|--no-open) OPEN=0 ;;
    *) SERVER_ARGS+=("$arg") ;;
  esac
done

healthy() { curl -fsS --max-time 1 "$BASE/api/health" 2>/dev/null | grep -q '"note-taker"'; }

open_viewer() {
  local url="$BASE/viewer"
  if command -v omarchy-launch-webapp >/dev/null; then
    omarchy-launch-webapp "$url" >/dev/null 2>&1 &
  elif command -v chromium >/dev/null; then
    setsid chromium --app="$url" >/dev/null 2>&1 &
  elif command -v google-chrome-stable >/dev/null; then
    setsid google-chrome-stable --app="$url" >/dev/null 2>&1 &
  else
    xdg-open "$url" >/dev/null 2>&1 &
  fi
}

if healthy; then
  echo "note-taker already running on :$PORT"
  [[ $OPEN == 1 ]] && open_viewer
  exit 0
fi

cd "$ROOT"
bun src/server/main.ts "${SERVER_ARGS[@]}" &
SERVER_PID=$!
trap 'kill "$SERVER_PID" 2>/dev/null || true' EXIT INT TERM

for _ in $(seq 1 50); do
  healthy && break
  kill -0 "$SERVER_PID" 2>/dev/null || { echo "server failed to start" >&2; exit 1; }
  sleep 0.1
done

[[ $OPEN == 1 ]] && open_viewer
wait "$SERVER_PID"
